[Unit]
Description=lark-agent-bridge — Feishu/Lark events ↔ LLM agent bridge
Documentation=https://github.com/lizhihao-leo/lark-agent-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
# WorkingDirectory holds the built `dist/`. Adjust if you install elsewhere.
WorkingDirectory=%h/lark-agent-bridge
EnvironmentFile=%h/lark-agent-bridge/.env
ExecStart=/usr/bin/node %h/lark-agent-bridge/dist/index.js
Restart=on-failure
RestartSec=3
# 5-minute total restart budget — beyond that, let the unit fall into
# 'failed' state so the operator notices instead of a silent restart loop.
StartLimitIntervalSec=300
StartLimitBurst=10
# Give graceful shutdown 10s before SIGKILL (we drain lark-cli children first).
TimeoutStopSec=10
KillSignal=SIGTERM

# Security hardening — only what's safe for this workload. The bridge does
# need outbound network and the lark-cli config file in $HOME.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/lark-agent-bridge %h/.lark-cli

# Structured JSON logs go straight to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lark-agent-bridge

[Install]
WantedBy=default.target
