[Unit]
Description=lark-agent-bridge — Feishu/Lark events ↔ LLM agent bridge
Documentation=https://github.com/lizhihao-leo/lark-agent-bridge
After=network-online.target
Wants=network-online.target
# 5-minute total restart budget — beyond that, let the unit fall into
# 'failed' state so the operator notices instead of a silent restart loop.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# WorkingDirectory holds the built `dist/`. Adjust if you install elsewhere.
WorkingDirectory=%h/lark-agent-bridge
EnvironmentFile=%h/lark-agent-bridge/.env
ExecStart=/usr/bin/node %h/lark-agent-bridge/dist/index.js
Restart=on-failure
RestartSec=3
# Give graceful shutdown 15s before SIGKILL (drains lark-cli children and
# any in-flight Claude Code subprocess).
TimeoutStopSec=15
KillSignal=SIGTERM
# Cascade SIGTERM to every child the bridge spawned.
KillMode=control-group

# User-mode services run as the invoking user already, so we deliberately
# omit User=, NoNewPrivileges, ProtectSystem=strict and ReadWritePaths —
# those are system-mode features and fail with 216/GROUP under user systemd.

# Structured JSON logs go straight to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lark-agent-bridge

[Install]
WantedBy=default.target

