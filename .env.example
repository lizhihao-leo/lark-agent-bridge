# ---- LLM ----------------------------------------------------------
# Bridge calls the Anthropic SDK with these three vars. They work with:
#   - Anthropic official  → https://api.anthropic.com,           model: claude-sonnet-4-6
#   - Volcengine ARK      → https://ark.cn-beijing.volces.com/api/plan, model: ark-code-latest
#   - AWS Bedrock-compatible proxies, OpenRouter, etc.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Bridge behaviour --------------------------------------------
# Which event to consume. Default is P2P + group @mentions for IM.
LARK_EVENT_KEY=im.message.receive_v1

# Identity for the lark-cli event consumer ('bot' or 'user').
LARK_EVENT_AS=bot

# Hard cap on user message length sent to the LLM (chars).
MAX_INPUT_CHARS=4000

# Conversation history retained per chat (number of turns).
MAX_HISTORY_TURNS=12

# Max reply tokens.
MAX_TOKENS_REPLY=1024

# SQLite database path (relative paths resolved against CWD at start).
STORE_PATH=data/bridge.sqlite

# How long to remember already-handled event_ids (days). Feishu's redelivery
# window is much shorter than this; the default is generous.
SEEN_EVENT_TTL_DAYS=7

# Group-chat trigger policy:
#   mention  — only when content starts with '@' (recommended)
#   all      — react to every message in any group the bot is in
#   off      — ignore group messages entirely (P2P only)
GROUP_TRIGGER=mention

# Optional bot @-prefix to strip from group content before sending to LLM
# (e.g. "@My Bot ").
BOT_AT_PREFIX=

# Enable LLM tool use (Anthropic tools API). When true, the model can call
# whitelisted lark-cli read tools and one scoped send-text tool.
# Requires a model that supports the tools API — confirmed working with
# claude-sonnet-4-6 on api.anthropic.com. Some compatibility proxies
# (e.g. Volcengine ARK routing to non-Claude models) may reject the
# `tools` parameter; leave this `false` if unsure.
ENABLE_TOOLS=false

# Backend:
#   anthropic-sdk (default) — one HTTP call per message via the Anthropic
#                              SDK. Cheap and fast.
#   claude-code             — spawn a headless `claude -p` per message.
#                              Real agentic loop (Bash/Read/Write/Edit/Grep).
#                              Higher cost & latency. The CLI inherits
#                              ANTHROPIC_* env so it routes to your provider.
BACKEND=anthropic-sdk

# For BACKEND=claude-code:
CLAUDE_CODE_SANDBOX=/home/leo/lark-bot-sandbox
CLAUDE_CODE_TIMEOUT_SEC=180
# Extra args appended to `claude -p ...`. Space-separated.
# Example: --allowedTools "Read Bash(ls *)" --append-system-prompt "Be terse."
CLAUDE_CODE_EXTRA_ARGS=
# Send "⏳ 思考中…" instantly and recall it after the real reply lands.
# Only affects BACKEND=claude-code.
SHOW_THINKING_PLACEHOLDER=true

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
