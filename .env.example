# ---- LLM ----------------------------------------------------------
# Bridge calls the Anthropic SDK with these three vars. They work with:
#   - Anthropic official  → https://api.anthropic.com,           model: claude-sonnet-4-6
#   - Volcengine ARK      → https://ark.cn-beijing.volces.com/api/plan, model: ark-code-latest
#   - AWS Bedrock-compatible proxies, OpenRouter, etc.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Bridge behaviour --------------------------------------------
# Which event to consume. Default is P2P + group @mentions for IM.
LARK_EVENT_KEY=im.message.receive_v1

# Identity for the lark-cli event consumer ('bot' or 'user').
LARK_EVENT_AS=bot

# Hard cap on user message length sent to the LLM (chars).
MAX_INPUT_CHARS=4000

# Conversation history retained per chat (number of turns).
MAX_HISTORY_TURNS=12

# Max reply tokens.
MAX_TOKENS_REPLY=1024

# SQLite database path (relative paths resolved against CWD at start).
STORE_PATH=data/bridge.sqlite

# How long to remember already-handled event_ids (days). Feishu's redelivery
# window is much shorter than this; the default is generous.
SEEN_EVENT_TTL_DAYS=7

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
